# ============================================================
# MizanAI
# Copy this file to .env or simply run:
#     python setup.py
# ============================================================

# Required for AI features
XAI_API_KEY=
XAI_MODEL=grok-4.7

# local | aws_whatsapp
MIZAN_MODE=local

# ============================================================
# Optional: WhatsApp + AWS mode
# ============================================================

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

AWS_REGION=eu-central-1
AWS_PROFILE=mizanai-worker

MIZAN_SQS_QUEUE_URL=
MIZAN_VOICE_BUCKET=
